#text proto 
platform: "ensemble"
max_batch_size: 0
input [
    {
        name: "image"
        data_type: TYPE_FP32
        dims: [1,3,1080,1920]
    }
]
output [
  {
    name: "OUTPUT_TEXT"
    data_type: TYPE_STRING
    dims: [ -1 ]
  }
]
ensemble_scheduling {
    step [
        {
            model_name: "License-Preprocessing"
            model_version: 1
            input_map {
                key: "image"
                value: "image"
            }
            output_map {
                key: "input_image"
                value: "input_image"
            }
        },
        {
            model_name: "Car-Detection"
            model_version: 1
            input_map {
                key: "images"
                value: "input_image"
            }
            output_map {
                key: "output0"
                value: "output0"
            }
        },
        {
            model_name: "Car-Detection-postprocessing"
            model_version: 1
            input_map{
                key: "output0"
                value: "output0"
            }
            output_map{
                key: "detection_bboxes"
                value: "detection_bboxes"
            }
            output_map{
                key: "detection_class_ids"
                value: "detection_class_ids"
            }
        },
        {
            model_name: "Trocr-Car-Pre"
            model_version: 1
            input_map{
                key:"image"
                value:"image"
            }
            input_map{
                key:"det_bboxes"
                value:"detection_bboxes"
            }
            output_map{
                key:"cropped_vehicles"
                value:"cropped_vehicles"
            }
        },
        {
            model_name: "PaddleOCR-Detection-Preprocessing"
            model_version: 1
            input_map{
                key: "cropped_vehicles"
                value: "cropped_vehicles"
            }
            output_map{
                key: "inp"
                value: "inp"
            }
            output_map{
                key: "shape_info"
                value: "shape_info"
            }
        },
        {
            model_name: "PaddleOCR-Detection"
            model_version: 1
            input_map{
                key: "inp"
                value: "inp"
            }
            output_map{
                key: "fetch_name"
                value: "fetch_name"
            }
        },
        {
            model_name: "PaddleOCR-Detection-Postprocessing"
            model_version: 1
            input_map{
                key: "fetch_name"
                value: "fetch_name"
            }
            input_map{
                key: "shape_info"
                value: "shape_info"
            }
            output_map{
                key: "Text_bboxes"
                value: "Text_bboxes"
            }
            output_map{
                key: "Counts"
                value: "Counts"
            }
        },
        {
            model_name: "PaddleOCR-Plate-Mapper"
            model_version: 1
            input_map{
                key: "Text_bboxes"
                value: "Text_bboxes"
            }
            input_map{
                key: "Counts"
                value: "Counts"
            }
            input_map{
                key: "detection_class_ids"
                value: "detection_class_ids"
            }
            input_map{
                key: "cropped_vehicles"
                value: "cropped_vehicles"
            }
            output_map{
                key: "cropped_images"
                value: "cropped_images"
            }
        },
        {
            model_name: "PaddleOCR-P4-Preprocessing"
            model_version: 1
            input_map{
                key: "cropped_images"
                value: "cropped_images"
            }
            output_map{
                key: "x"
                value: "x"
            }
        },
        {
            model_name:"PaddleOCR"
            model_version: 1
            input_map{
                key:"x"
                value:"x"
            }
            output_map{
                key:"fetch_name_0"
                value:"fetch_name_0"
            }
        },
        {
            model_name:"PaddleOCR-Postprocessing"
            model_version: 1
            input_map{
                key:"fetch_name_0"
                value:"fetch_name_0"
            }
            output_map{
                key:"OUTPUT_TEXT"
                value:"OUTPUT_TEXT"
            }
        }         
    ]
}
