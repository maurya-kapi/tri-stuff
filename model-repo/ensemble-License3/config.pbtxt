#text proto 
platform: "ensemble"
max_batch_size: 0
input [
    {
        name: "image"
        data_type: TYPE_FP32
        dims: [1,3,1080,1920]
    }
]
output [
  {
    name: "OUTPUT_TEXT"
    data_type: TYPE_STRING
    dims: [ -1 ]
  },
  {
    name: "mapped_det_bboxes"
    data_type: TYPE_FP32
    dims: [-1,4]
  }
]
ensemble_scheduling {
    step [
        {
            model_name: "License-Preprocessing"
            model_version: 1
            input_map {
                key: "image"
                value: "image"
            }
            output_map {
                key: "input_image"
                value: "input_image"
            }
        },
        {
            model_name: "Car-Detection"
            model_version: 1
            input_map {
                key: "images"
                value: "input_image"
            }
            output_map {
                key: "output0"
                value: "output0"
            }
        },
        {
            model_name: "Car-Detection-postprocessing"
            model_version: 1
            input_map{
                key: "output0"
                value: "output0"
            }
            output_map{
                key: "detection_bboxes"
                value: "detection_bboxes"
            }
        },
        {
            model_name: "Trocr-Car-Pre"
            model_version: 1
            input_map{
                key:"image"
                value:"image"
            }
            input_map{
                key:"det_bboxes"
                value:"detection_bboxes"
            }
            output_map{
                key:"cropped_vehicles"
                value:"cropped_vehicles"
            }
            output_map{
                key: "mapped_boxes"
                value: "mapped_boxes"
            }
        },
        {
            model_name: "trocr"
            model_version: 1
            input_map{
                key: "INPUT_IMAGE"
                value: "cropped_vehicles"
            }
            input_map{
                key: "mapped_boxes"
                value: "mapped_boxes"
            }
            output_map{
                key: "OUTPUT_TEXT"
                value: "OUTPUT_TEXT"
            }
            output_map{
                key: "mapped_det_bboxes"
                value: "mapped_det_bboxes"
            }
        }     
    ]
}
