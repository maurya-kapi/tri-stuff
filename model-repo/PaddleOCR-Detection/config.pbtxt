name: "PaddleOCR-Detection"
platform: "onnxruntime_onnx"

input [
  {
    name: "x"
    data_type: TYPE_FP32
    dims: [-1,3, -1, -1]
  }
]

output [
  {
    name: "sigmoid_0.tmp_0"
    data_type: TYPE_FP32
    dims: [-1,1, -1, -1]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]


