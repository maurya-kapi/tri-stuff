name: "trocr"
backend: "python"
max_batch_size: 0

input [
  {
    name: "INPUT_IMAGE"
    data_type: TYPE_FP32
    dims: [-1,3,-1,-1 ]  # Height, Width, Channels
  },
  {
    name: "mapped_boxes"
    data_type: TYPE_INT32
    dims: [-1,4]
  }
]

output [
  {
    name: "OUTPUT_TEXT"
    data_type: TYPE_STRING
    dims: [ -1 ]
  },
  {
    name: "mapped_det_bboxes"
    data_type: TYPE_FP32
    dims: [-1,4]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

version_policy: {
  specific { versions: [1] }
}
