backend: "python"
max_batch_size: 0

input [
  {
       name: "Text_bboxes"
       data_type: TYPE_FP32
       dims: [-1,4,2] 
  },
  {
        name: "Counts"
        data_type: TYPE_INT32
        dims: [-1]
  },
  {
        name: "detection_class_ids"
        data_type: TYPE_INT32
        dims: [-1]
  },
  {
        name: "cropped_vehicles"
        data_type: TYPE_FP32
        dims:[-1,3,-1,-1]
  },
  {
        name: "vehicle_boxes"
        data_type: TYPE_FP32
        dims: [-1,4]
  }
]

output [
    {
       name: "cropped_images"
       data_type: TYPE_FP32
       dims: [-1,3,-1,-1] 
    },
    {
       name: "bboxes"
       data_type: TYPE_FP32
       dims: [-1,4]
    }
]
