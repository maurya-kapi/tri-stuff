name: "PaddleOCR-P4-Preprocessing"
backend: "python"
max_batch_size: 0  
input [
    {
        name: "cropped_images"
        data_type: TYPE_FP32
        dims: [-1,3,-1,-1]
    },
    {
        name: "bboxes"
        data_type: TYPE_FP32
        dims: [-1,4]
    }
]

output [
  {
    name: "x"
    data_type: TYPE_FP32
    dims: [-1, 3, 48, 320]
  },
  {
    name: "mapped_boxes"
    data_type: TYPE_FP32
    dims: [-1,4]
  }
]
